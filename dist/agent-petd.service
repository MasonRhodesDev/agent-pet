[Unit]
Description=Agent Pet — desktop mascot reflecting AI agent activity
Documentation=https://github.com/MasonRhodesDev/agent-pet
After=graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=dbus
BusName=io.github.masonrhodesdev.AgentPet
ExecStart=/usr/bin/agent-petd
Restart=on-failure
RestartSec=1
Slice=background.slice

[Install]
WantedBy=graphical-session.target
